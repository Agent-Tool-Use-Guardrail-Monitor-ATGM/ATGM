          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.verdict || ' → B1 ' ||\n       CASE WHEN s.score >= 0.5 THEN 'violating' ELSE 'compliant' END AS outcome,\n       count(*) AS sessions\nFROM scores s\nJOIN (SELECT DISTINCT ON (session_id) session_id, verdict\n      FROM labels ORDER BY session_id, occurred_at DESC) l ON l.session_id = s.session_id\nWHERE s.detector = 'b1_classifier' AND $__timeFilter(s.occurred_at)\nGROUP BY 1 ORDER BY 2 DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
