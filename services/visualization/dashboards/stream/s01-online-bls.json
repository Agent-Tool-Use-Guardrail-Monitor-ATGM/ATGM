        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "atgm-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at,'1m'), agent_id AS metric, count(*) AS value FROM other_events WHERE event_type = 'classifier.error' AND data->>'detector' = 'online_bls' AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1"
        }
