{
  "uid": "atgm-s01-online-bls",
  "title": "S01 Online-BLS",
  "tags": [
    "atgm",
    "stream"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Mean prefix risk score",
      "description": "One-minute mean of emitted prefix scores per agent. Includes warm-up scores.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "atgm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "atgm-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at,'1m'), agent_id AS metric, avg(score) AS value FROM scores WHERE detector = 'online_bls' AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Reviewed prediction error rate",
      "description": "Mean binary prediction error among reviewed sessions. Warm-up sessions are excluded by the publisher.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "atgm-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "atgm-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at,'1m'), agent_id AS metric, avg((data->>'error')::numeric) AS value FROM other_events WHERE event_type = 'classifier.error' AND data->>'detector' = 'online_bls' AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "title": "Scored prefixes",
      "description": "Volume of scored tool-call prefixes per minute.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "atgm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "atgm-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at,'1m'), agent_id AS metric, count(*) AS value FROM scores WHERE detector = 'online_bls' AND $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
